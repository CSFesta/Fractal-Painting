{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug main (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/code/main.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/code",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/MinGW/bin/gdb.exe",
            "preLaunchTask": "build main",
            "setupCommands": [
                {
                    "description": "Habilitar pretty-printing no gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
